  {
   "id": 1,
   "title": "Status dos serviços",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 12,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "FORA",
         "color": "red"
        },
        "1": {
         "text": "NO AR",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "up{job!='prometheus'}",
     "legendFormat": "{{job}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "description": "1 = o Prometheus consegue coletar métricas do serviço",
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value_and_name"
   }
  },
